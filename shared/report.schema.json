{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThorShield report 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","app_version","implementation","collected_at","observations","findings","errors"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "app_version": {"type":"string"},
    "implementation": {"enum":["java","python","rust"]},
    "collected_at": {"type":"string","format":"date-time"},
    "observations": {"type":"array","items":{"$ref":"#/$defs/observation"}},
    "findings": {"type":"array","items":{
      "type":"object","additionalProperties":false,
      "required":["rule_id","severity","observation_ids","message","suggestion"],
      "properties":{
        "rule_id":{"type":"string"},"severity":{"enum":["ok","warning","unknown"]},
        "observation_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
        "message":{"type":"string"},"suggestion":{"type":"string"}
      }
    }},
    "errors": {"type":"array","items":{
      "type":"object","additionalProperties":false,"required":["observation_id","status"],
      "properties":{"observation_id":{"type":"string"},"status":{"enum":["unavailable","access_denied","timeout","invalid_data"]}}
    }}
  },
  "$defs": {
    "observation": {
      "type":"object","additionalProperties":false,
      "required":["id","source","collected_at","status","value"],
      "properties":{
        "id":{"enum":["defender","firewall"]},"source":{"type":"string"},
        "collected_at":{"type":"string","format":"date-time"},
        "status":{"enum":["success","unavailable","access_denied","timeout","invalid_data"]},
        "value":{"type":["object","null"]}
      },
      "allOf":[
        {"if":{"properties":{"status":{"const":"success"},"id":{"const":"defender"}}},"then":{"properties":{"value":{
          "type":"object","additionalProperties":false,"required":["antivirus_enabled","realtime_enabled","running_mode"],
          "properties":{"antivirus_enabled":{"type":"boolean"},"realtime_enabled":{"type":"boolean"},"running_mode":{"type":"string","minLength":1,"maxLength":80}}
        }}}},
        {"if":{"properties":{"status":{"const":"success"},"id":{"const":"firewall"}}},"then":{"properties":{"value":{
          "type":"object","additionalProperties":false,"required":["Domain","Private","Public"],
          "properties":{"Domain":{"type":"boolean"},"Private":{"type":"boolean"},"Public":{"type":"boolean"}}
        }}}},
        {"if":{"properties":{"status":{"not":{"const":"success"}}}},"then":{"properties":{"value":{"type":"null"}}}}
      ]
    }
  }
}
